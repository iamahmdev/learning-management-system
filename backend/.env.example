# =====================================================
# DATABASE CONFIGURATION
# =====================================================
MONGODB_URI=mongodb://localhost:27017/school_management_system

# =====================================================
# JWT CONFIGURATION
# =====================================================
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# =====================================================
# SERVER CONFIGURATION
# =====================================================
PORT=5000
NODE_ENV=development

# =====================================================
# FRONTEND URL (for CORS)
# =====================================================
FRONTEND_URL=http://localhost:3000

# =====================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# =====================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@schoolsystem.com

# =====================================================
# CLOUDINARY CONFIGURATION (Optional - for file uploads)
# =====================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =====================================================
# ADMIN CREDENTIALS (for initial admin login)
# =====================================================
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=admin@123456

# =====================================================
# RATE LIMITING (Optional)
# =====================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =====================================================
# SESSION CONFIGURATION
# =====================================================
SESSION_SECRET=your_session_secret_key_change_this

# =====================================================
# FILE UPLOAD CONFIGURATION
# =====================================================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# =====================================================
# NOTES:
# =====================================================
# 1. Copy this file to .env and update with your values
# 2. Never commit .env file to git
# 3. Change all secret keys in production
# 4. Use strong passwords for admin account
# 5. For production, use environment-specific MongoDB URI
# 6. Enable email service for password reset functionality
# 7. Configure Cloudinary for file uploads (assignments, profile pictures)
# =====================================================
